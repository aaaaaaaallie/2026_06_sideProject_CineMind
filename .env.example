# 複製為 .env 並填入值。各金鑰取得方式見 README.md
TELEGRAM_BOT_TOKEN=            # @BotFather /newbot
TELEGRAM_SECRET_TOKEN=         # 自產亂數，setWebhook 時帶上，webhook 驗證用
TELEGRAM_ALLOWED_CHAT_ID=      # 本人 chat id（跑 npm run dev:bot 對 bot 說話，從 log 取得）
GEMINI_API_KEY=                # Google AI Studio
OMDB_API_KEY=                  # https://www.omdbapi.com/apikey.aspx（Free, 1000 req/day）
UPSTASH_REDIS_REST_URL=        # Vercel Marketplace 裝 Upstash Redis 後，從 console 複製
UPSTASH_REDIS_REST_TOKEN=
DASHBOARD_TOKEN=               # Dashboard 登入密碼（自訂）
